# Telegram
BOT_TOKEN=123456789:AAExampleTelegramBotTokenGoesHere
ADMIN_CHAT_ID=123456789
VIP_CHANNEL_ID=-1001234567890

# Database (SQLite by default; use a PostgreSQL URL in production, e.g.
# postgresql://user:password@host:5432/dbname)
DATABASE_URL=sqlite:///onward_signals.db

# Payment wallets
TRC20_WALLET=TExampleTronWalletAddressXXXXXXXXX
BSC_WALLET=0xExampleBscWalletAddressXXXXXXXXXXXXXXXX
BINANCE_UID=123456789

# Block explorer APIs
BSCSCAN_API_KEY=your_bscscan_api_key
TRONGRID_API_KEY=

# Subscription plans
PRICE_MONTHLY=49
PRICE_QUARTERLY=120
PRICE_YEARLY=399
PAYMENT_AMOUNT_TOLERANCE=0.5

# Expired-subscription check interval, in seconds (default: 3600 = 1 hour)
SCHEDULER_INTERVAL_SECONDS=3600

# Telegram username shown behind the Support button (without @)
SUPPORT_USERNAME=oonyxai_Support3
